# Copia este archivo como .env y cambia los valores.
NODE_ENV=development
PORT=4000

# Ruta del archivo SQLite (relativa a apps/api)
DB_PATH=./data/plataforma.sqlite

# Secreto para firmar sesiones. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-de-al-menos-32-caracteres
