{
  "name": "@lv/api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generar": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/scripts/migrar.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/scripts/seed.ts",
    "db:demo": "tsx --env-file-if-exists=.env src/scripts/demo.ts",
    "db:importar-legado": "tsx --env-file-if-exists=.env src/scripts/importar-legado.ts",
    "docente:crear": "tsx --env-file-if-exists=.env src/scripts/crear-docente.ts"
  },
  "dependencies": {
    "@lv/shared": "*",
    "better-sqlite3": "^12.4.1",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.18.0",
    "drizzle-kit": "^0.31.5",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}
